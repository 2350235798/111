{
  "buildCommand": "node deploy/build.js",
  "outputDirectory": "dist/client",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!assets/|favicon).*)", "destination": "/index.html" }
  ]
}
